# Get this connection string from your Neon project dashboard
# (or any Postgres instance) - looks like:
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Port the API server listens on
PORT=4000

# Secret code that unlocks the admin panel (/admin on the frontend).
# Make this a long random string only you know - anyone who has it
# can add, edit, or delete listings. Do not commit this file.
ADMIN_SECRET=

# Secret used to sign user login sessions (JWTs). Make this a long
# random string - if it leaks, anyone can forge a logged-in session
# for any user. Do not commit this file.
JWT_SECRET=

# Comma-separated list of frontend origins allowed to call this API,
# e.g. https://your-site.com or https://your-site.vercel.app
# Leave unset for local development (allows any origin) - but ALWAYS
# set this before deploying publicly, or any website can call your API
# from a visitor's browser using their logged-in session.
ALLOWED_ORIGINS=

# Brevo (https://www.brevo.com) sends account-verification and
# password-reset emails via their HTTP API - no SMTP setup needed.
# Get BREVO_API_KEY from Brevo -> Settings -> SMTP & API -> API Keys.
# BREVO_SENDER_EMAIL must be an email/domain you've verified as a
# sender in Brevo (Settings -> Senders & IP), or sends will fail.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Where To Go Sour
